  "commit": "c7778cf56d90e409c75e59b82842544b118fa850",
  "prompt": "MySQL string literals with backslash escapes are not decoded. In MySQL, sequences like \\0, \\n and \\t inside a string denote special characters, so the parsed value should hold the decoded character and generation must escape it correctly again, in MySQL-family dialects and when transpiling to others (for example ClickHouse). Related: IS_ASCII(x) from the default dialect should transpile to SingleStore as a regular-expression check on the ASCII range.\n\nFor example:\n\n```python\nfrom sqlglot import parse_one, transpile, exp\n\nrepr(parse_one(r\"SELECT 'a\\0b'\", read=\"mysql\").selects[0].this)\n# currently: 'a\\\\0b'\n# expected:  'a\\x00b'\n\nparse_one(r\"SELECT '\\0'\", read=\"mysql\").sql(\"clickhouse\")\n# currently: SELECT '\\\\0'\n# expected:  SELECT '\\0'\n\ntranspile(\"SELECT IS_ASCII('a')\", write=\"singlestore\")[0]\n# currently: SELECT ('a' RLIKE '^[\\x00-\\x7f]*$')\n# expected:  SELECT ('a' RLIKE '^[\\0-\\x7f]*$')\n```\n\nOther forms of the same constructs described above should work as well.",
  "hidden_tests": [
    "tests/dialects/test_clickhouse.py::TestClickhouse::test_clickhouse",
    "tests/dialects/test_singlestore.py::TestSingleStore::test_is_ascii"
  ],
  "test_patch": "diff --git a/tests/dialects/test_clickhouse.py b/tests/dialects/test_clickhouse.py\nindex a1f7ca280..9b486e0f5 100644\n--- a/tests/dialects/test_clickhouse.py\n+++ b/tests/dialects/test_clickhouse.py\n@@ -501,7 +501,7 @@ class TestClickhouse(Validator):\n             },\n             write={\n                 \"clickhouse\": \"SELECT '\\\\0'\",\n-                \"mysql\": \"SELECT '\\0'\",\n+                \"mysql\": \"SELECT '\\\\0'\",\n             },\n         )\n         self.validate_all(\ndiff --git a/tests/dialects/test_singlestore.py b/tests/dialects/test_singlestore.py\nindex dd4da5190..c44ffdd37 100644\n--- a/tests/dialects/test_singlestore.py\n+++ b/tests/dialects/test_singlestore.py\n@@ -436,6 +436,24 @@ class TestSingleStore(Validator):\n             },\n         )\n \n+    def test_is_ascii(self):\n+        self.validate_identity(\n+            \"SELECT ('a' RLIKE '^[\\x00-\\x7f]*$')\",\n+            \"SELECT ('a' RLIKE '^[\\\\0-\\x7f]*$')\",\n+        )\n+        self.validate_all(\n+            \"SELECT ('a' RLIKE '^[\\\\0-\\x7f]*$')\",\n+            read={\"\": \"SELECT IS_ASCII('a')\"},\n+        )\n+        self.validate_all(\n+            \"SELECT 1 + ('a' RLIKE '^[\\\\0-\\x7f]*$')\",\n+            read={\"\": \"SELECT 1 + IS_ASCII('a')\"},\n+        )\n+        self.validate_all(\n+            \"SELECT NOT ('é' RLIKE '^[\\\\0-\\x7f]*$')\",\n+            read={\"\": \"SELECT NOT IS_ASCII('é')\"},\n+        )\n+\n     def test_string_functions(self):\n         self.validate_all(\n             \"SELECT 'a' RLIKE 'b'\",\n@@ -460,10 +478,6 @@ class TestSingleStore(Validator):\n                 \"singlestore\": \"SELECT REGEXP_SUBSTR('adog', 'O', 1, 1, 'c')\",\n             },\n         )\n-        self.validate_all(\n-            \"SELECT ('a' RLIKE '^[\\x00-\\x7f]*$')\",\n-            read={\"singlestore\": \"SELECT ('a' RLIKE '^[\\x00-\\x7f]*$')\", \"\": \"SELECT IS_ASCII('a')\"},\n-        )\n         self.validate_all(\n             \"SELECT UNHEX(MD5('data'))\",\n             read={\n",
